# Copy to `.env` — `npm run example` auto-loads it (via node --env-file-if-exists).
# These are the same LOG_PORTAL_* vars mountLogPortal() reads from process.env in
# any backend; options passed to mountLogPortal(app, {...}) take precedence over them.

# --- Example server only ---
PORT=4000

# --- Core ---
# LOG_PORTAL_BASE_PATH=/api/_logs
# LOG_PORTAL_DIR=./logs
# LOG_PORTAL_RETENTION_DAYS=2
# LOG_PORTAL_MAX_FILE_MB=50
# LOG_PORTAL_FLUSH_MS=0
# LOG_PORTAL_BUFFER_LINES=1000
# LOG_PORTAL_CAPTURE_CONSOLE=true
# LOG_PORTAL_LOG_REQUESTS=true
# LOG_PORTAL_DETECT_THREATS=true
# LOG_PORTAL_MAX_URL_LEN=2000
# LOG_PORTAL_ENABLED=true

# --- Built-in auth (all required together to turn auth on) ---
# LOG_PORTAL_AUTH_ENABLED=true
# LOG_PORTAL_AUTH_SECRET=change-me
# LOG_PORTAL_ADMIN_EMAIL=you@example.com
# LOG_PORTAL_ADMIN_PASSWORD=change-me
# LOG_PORTAL_ADMIN_SECURITY_CODE=1234
# LOG_PORTAL_AUTH_DB=./logs/log-portal-auth.json
# LOG_PORTAL_SESSION_TTL_MIN=120
# LOG_PORTAL_E2E_ENABLED=true
