{
  "name": "log-portal",
  "version": "1.0.0",
  "description": "A drop-in logging package for Express + TypeScript backends. It writes structured logs to the filesystem as JSONL and exposes a read API (historical + live SSE) so a dashboard can show server logs to any developer — no SSH or server access needed.",
  "license": "ISC",
  "author": "Achego Tamunobelema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achego/log-portal.git"
  },
  "bugs": {
    "url": "https://github.com/achego/log-portal/issues"
  },
  "homepage": "https://github.com/achego/log-portal#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx --env-file-if-exists=.env example/server.ts",
    "example:watch": "tsx watch --env-file-if-exists=.env example/server.ts",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "logging",
    "logs",
    "express",
    "typescript",
    "jsonl",
    "sse",
    "dashboard",
    "winston",
    "middleware",
    "observability"
  ],
  "peerDependencies": {
    "express": "^4.17.0 || ^5.0.0",
    "winston-transport": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "winston-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.21.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "winston-transport": "^4.7.0"
  }
}
